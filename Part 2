-- 4. Spin
local spinRow = createCmdRow()
local spinBtn = Instance.new("TextButton")
spinBtn.Size = UDim2.new(0.72, 0, 1, 0)
spinBtn.BackgroundColor3 = Color3.fromRGB(35, 35, 35)
spinBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
spinBtn.Text = "Spin: OFF"
spinBtn.Font = Enum.Font.GothamBold
spinBtn.TextSize = 11
spinBtn.Parent = spinRow
Instance.new("UICorner", spinBtn).CornerRadius = UDim.new(0, 4)

local spinInput = Instance.new("TextBox")
spinInput.Size = UDim2.new(0.25, 0, 1, 0)
spinInput.Position = UDim2.new(0.75, 0, 0, 0)
spinInput.BackgroundColor3 = Color3.fromRGB(45, 45, 45)
spinInput.TextColor3 = Color3.fromRGB(255, 255, 255)
spinInput.Text = "10"
spinInput.Font = Enum.Font.GothamBold
spinInput.TextSize = 11
spinInput.Parent = spinRow
Instance.new("UICorner", spinInput).CornerRadius = UDim.new(0, 4)

local spinActive = false
spinBtn.MouseButton1Click:Connect(function()
	if #selectedNPCs == 0 then
		notifyTemp(spinBtn, "Spin: " .. (spinActive and "ON" or "OFF"), "Select a target first", 1.5)
		return
	end
	spinActive = not spinActive
	spinBtn.Text = "Spin: " .. (spinActive and "ON" or "OFF")
	spinBtn.BackgroundColor3 = spinActive and Color3.fromRGB(50, 120, 50) or Color3.fromRGB(35, 35, 35)
	local spd = tonumber(spinInput.Text) or 10
	
	for _, npc in ipairs(selectedNPCs) do
		local root = npc:FindFirstChild("HumanoidRootPart")
		if root then
			local att = root:FindFirstChild("SpinAttachment") or Instance.new("Attachment", root)
			att.Name = "SpinAttachment"
			local angV = root:FindFirstChild("SpinVelocity") or Instance.new("AngularVelocity", root)
			angV.Name = "SpinVelocity"
			angV.Attachment0 = att
			angV.MaxTorque = math.huge
			angV.AngularVelocity = spinActive and Vector3.new(0, spd, 0) or Vector3.new(0, 0, 0)
			angV.RelativeTo = Enum.ActuatorRelativeTo.World
			if not spinActive then
				angV:Destroy()
				att:Destroy()
			end
		end
	end
end)

-- 5. Bring
local bringRow = createCmdRow()
local bringBtn = Instance.new("TextButton")
bringBtn.Size = UDim2.new(0.72, 0, 1, 0)
bringBtn.BackgroundColor3 = Color3.fromRGB(35, 35, 35)
bringBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
bringBtn.Text = "Bring Target"
bringBtn.Font = Enum.Font.GothamBold
bringBtn.TextSize = 11
bringBtn.Parent = bringRow
Instance.new("UICorner", bringBtn).CornerRadius = UDim.new(0, 4)

local bringInput = Instance.new("TextBox")
bringInput.Size = UDim2.new(0.25, 0, 1, 0)
bringInput.Position = UDim2.new(0.75, 0, 0, 0)
bringInput.BackgroundColor3 = Color3.fromRGB(45, 45, 45)
bringInput.TextColor3 = Color3.fromRGB(255, 255, 255)
bringInput.Text = "5"
bringInput.Font = Enum.Font.GothamBold
bringInput.TextSize = 11
bringInput.Parent = bringRow
Instance.new("UICorner", bringInput).CornerRadius = UDim.new(0, 4)

bringBtn.MouseButton1Click:Connect(function()
	if #selectedNPCs == 0 then
		notifyTemp(bringBtn, "Bring Target", "Select a target first", 1.5)
		return
	end
	local char = LocalPlayer.Character
	if not char or not char:FindFirstChild("HumanoidRootPart") then return end
	local pRoot = char.HumanoidRootPart
	local dist = tonumber(bringInput.Text) or 5
	local targetPos = pRoot.CFrame + (pRoot.CFrame.LookVector * dist)
	
	for _, npc in ipairs(selectedNPCs) do
		local root = npc:FindFirstChild("HumanoidRootPart")
		if root then
			root.CFrame = targetPos
		end
	end
end)

