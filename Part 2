gotoInput.BackgroundColor3 = Color3.fromRGB(45, 45, 45)
gotoInput.TextColor3 = Color3.fromRGB(255, 255, 255)
gotoInput.Text = "5"
gotoInput.Font = Enum.Font.GothamBold
gotoInput.TextSize = 11
gotoInput.Parent = gotoRow
Instance.new("UICorner", gotoInput).CornerRadius = UDim.new(0, 4)

gotoBtn.MouseButton1Click:Connect(function()
	if #selectedNPCs ~= 1 then
		notifyTemp(gotoBtn, "Go To Target", "Only 1 selected target works", 1.5)
		return
	end
	local char = LocalPlayer.Character
	if not char or not char:FindFirstChild("HumanoidRootPart") then return end
	local pRoot = char.HumanoidRootPart
	local npc = selectedNPCs[1]
	local root = npc:FindFirstChild("HumanoidRootPart")
	if root then
		local dist = tonumber(gotoInput.Text) or 5
		pRoot.CFrame = root.CFrame - (root.CFrame.LookVector * dist) + Vector3.new(0, 3, 0)
	end
end)

