local cmdLayout = Instance.new("UIListLayout")
cmdLayout.SortOrder = Enum.SortOrder.LayoutOrder
cmdLayout.Padding = UDim.new(0, 6)
cmdLayout.Parent = pageCmd

local function createCmdRow()
	local r = Instance.new("Frame")
	r.Size = UDim2.new(1, 0, 0, 32)
	r.BackgroundTransparency = 1
	r.Parent = pageCmd
	return r
end

local function notifyTemp(btn, originalText, tempText, duration)
	btn.Text = tempText
	task.delay(duration or 1.5, function()
		if btn.Text == tempText then
			btn.Text = originalText
		end
	end)
end

-- 1. Freeze
local freezeRow = createCmdRow()
local freezeBtn = Instance.new("TextButton")
freezeBtn.Size = UDim2.new(1, 0, 1, 0)
freezeBtn.BackgroundColor3 = Color3.fromRGB(35, 35, 35)
freezeBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
freezeBtn.Text = "Freeze: OFF"
freezeBtn.Font = Enum.Font.GothamBold
freezeBtn.TextSize = 11
freezeBtn.Parent = freezeRow
Instance.new("UICorner", freezeBtn).CornerRadius = UDim.new(0, 4)

local freezeActive = false
freezeBtn.MouseButton1Click:Connect(function()
	if #selectedNPCs == 0 then
		notifyTemp(freezeBtn, "Freeze: " .. (freezeActive and "ON" or "OFF"), "Select a target first", 1.5)
		return
	end
	freezeActive = not freezeActive
	freezeBtn.Text = "Freeze: " .. (freezeActive and "ON" or "OFF")
	freezeBtn.BackgroundColor3 = freezeActive and Color3.fromRGB(50, 120, 50) or Color3.fromRGB(35, 35, 35)
	
	for _, npc in ipairs(selectedNPCs) do
		local hum = npc:FindFirstChildOfClass("Humanoid")
		local root = npc:FindFirstChild("HumanoidRootPart")
		if hum then hum.PlatformStand = freezeActive end
		if root then root.Anchored = freezeActive end
	end
end)

