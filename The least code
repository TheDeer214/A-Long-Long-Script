local function refreshNPCList()
	for _, child in ipairs(scrollingEntities:GetChildren()) do
		if child:IsA("TextButton") then child:Destroy() end
	end
	
	local npcs = getNPCs()
	for _, npc in ipairs(npcs) do
		local rowBtn = Instance.new("TextButton")
		rowBtn.Size = UDim2.new(1, 0, 0, 28)
		local isSel = table.find(selectedNPCs, npc) ~= nil
		rowBtn.BackgroundColor3 = isSel and Color3.fromRGB(40, 100, 40) or Color3.fromRGB(35, 35, 35)
		rowBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
		rowBtn.Text = npc.Name .. (isSel and " [Selected]" or "")
		rowBtn.Font = Enum.Font.Gotham
		rowBtn.TextSize = 11
		rowBtn.Parent = scrollingEntities
		Instance.new("UICorner", rowBtn).CornerRadius = UDim.new(0, 4)
		
		local targetNpc = npc
		rowBtn.MouseButton1Click:Connect(function()
			local idx = table.find(selectedNPCs, targetNpc)
			if idx then
				table.remove(selectedNPCs, idx)
			else
				table.insert(selectedNPCs, targetNpc)
			end
			refreshNPCList()
		end)
	end
	scrollingEntities.CanvasSize = UDim2.new(0, 0, 0, #npcs * 32)
end

selectAllMainBtn.MouseButton1Click:Connect(function()
	selectedNPCs = getNPCs()
	refreshNPCList()
end)

task.spawn(function()
	while true do
		refreshNPCList()
		task.wait(0.8)
	end
end)

