Instance.new("UICorner", gotoInput).CornerRadius = UDim.new(0, 4)

gotoBtn.MouseButton1Click:Connect(function()
	if #selectedNPCs ~= 1 then
		notifyTemp(gotoBtn, "Go To Target", "Only 1 selected target works", 1.5)
		return
	end
	local char = LocalPlayer.Character
	if not char or not char:FindFirstChild("HumanoidRootPart") then return end
	local pRoot = char.HumanoidRootPart
	local npc = selectedNPCs[1]
	local root = npc:FindFirstChild("HumanoidRootPart")
	if root then
		local dist = tonumber(gotoInput.Text) or 5
		pRoot.CFrame = root.CFrame - (root.CFrame.LookVector * dist) + Vector3.new(0, 3, 0)
	end
end)

-- 7. Kill
local killRow = createCmdRow()
local killBtn = Instance.new("TextButton")
killBtn.Size = UDim2.new(1, 0, 1, 0)
killBtn.BackgroundColor3 = Color3.fromRGB(120, 40, 40)
killBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
killBtn.Text = "Kill Target"
killBtn.Font = Enum.Font.GothamBold
killBtn.TextSize = 11
killBtn.Parent = killRow
Instance.new("UICorner", killBtn).CornerRadius = UDim.new(0, 4)

killBtn.MouseButton1Click:Connect(function()
	if #selectedNPCs == 0 then
		notifyTemp(killBtn, "Kill Target", "Select a target first", 1.5)
		return
	end
	for _, npc in ipairs(selectedNPCs) do
		local hum = npc:FindFirstChildOfClass("Humanoid")
		local root = npc:FindFirstChild("HumanoidRootPart")
		if hum then hum.Health = 0 end
		if root then
			root.CFrame = root.CFrame - Vector3.new(0, -1000, 0)
		end
	end
end)
