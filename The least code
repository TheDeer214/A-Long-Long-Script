RunService.RenderStepped:Connect(function()
	if not anchorEnabled then return end
	if controlEnabled then return end
	
	local target = selectedNPCs[1]
	if not target or not target.Parent then return end
	
	local targetRoot = target:FindFirstChild("HumanoidRootPart")
	local char = LocalPlayer.Character
	if not targetRoot or not char then return end
	
	local pRoot = char:FindFirstChild("HumanoidRootPart")
	if not pRoot then return end
	
	local yOffset = tonumber(offsetInput.Text) or -10
	
	-- Anchor the player's root part temporarily each frame to completely nullify gravity and falling velocity
	pRoot.Anchored = true
	local targetPos = targetRoot.Position
	pRoot.CFrame = CFrame.new(targetPos.X, targetPos.Y + yOffset, targetPos.Z)
end)
