-- Feature Logic: Highlights & Scaling Name Tags
local highlightEnabled = false
local tagsEnabled = false
local activeHighlights = {}
local activeTags = {}

highlightBtn.MouseButton1Click:Connect(function()
	highlightEnabled = not highlightEnabled
	highlightBtn.Text = "Highlight: " .. (highlightEnabled and "ON" or "OFF")
	highlightBtn.BackgroundColor3 = highlightEnabled and Color3.fromRGB(50, 120, 50) or Color3.fromRGB(35, 35, 35)
	if not highlightEnabled then
		for _, h in pairs(activeHighlights) do if h then h:Destroy() end end
		activeHighlights = {}
	end
end)

tagsBtn.MouseButton1Click:Connect(function()
	tagsEnabled = not tagsEnabled
	tagsBtn.Text = "Name Tags: " .. (tagsEnabled and "ON" or "OFF")
	tagsBtn.BackgroundColor3 = tagsEnabled and Color3.fromRGB(50, 120, 50) or Color3.fromRGB(35, 35, 35)
	if not tagsEnabled then
		for _, t in pairs(activeTags) do if t then t:Destroy() end end
		activeTags = {}
	end
end)

-- Continuous update loop for highlights, name tags, and distance scaling
RunService.RenderStepped:Connect(function()
	local npcs = getNPCs()
	
	-- Handle Highlights for Selected NPCs
	if highlightEnabled then
		for _, npc in ipairs(npcs) do
			if table.find(selectedNPCs, npc) then
				if not activeHighlights[npc] then
					local h = Instance.new("Highlight")
					h.FillColor = Color3.fromRGB(255, 60, 60)
					h.OutlineColor = Color3.fromRGB(255, 255, 255)
					h.Parent = npc
					activeHighlights[npc] = h
				end
			else
				if activeHighlights[npc] then
					activeHighlights[npc]:Destroy()
					activeHighlights[npc] = nil
				end
			end
		end
	end
	
	-- Handle Distance-Scaled Name Tags for All NPCs
	if tagsEnabled and LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
		local pPos = LocalPlayer.Character.HumanoidRootPart.Position
		for _, npc in ipairs(npcs) do
			local root = npc:FindFirstChild("HumanoidRootPart")
			if root then
				local tag = activeTags[npc]
				local dist = (root.Position - pPos).Magnitude
				
				if not tag then
					tag = Instance.new("BillboardGui")
					tag.Name = "EntityNameTag"
					tag.Size = UDim2.new(0, 120, 0, 30)
					tag.StudsOffset = Vector3.new(0, 2.5, 0)
					tag.AlwaysOnTop = true
					
					local lbl = Instance.new("TextLabel")
					lbl.Name = "Label"
					lbl.Size = UDim2.new(1, 0, 1, 0)
					lbl.BackgroundTransparency = 1
					lbl.TextColor3 = Color3.fromRGB(255, 255, 255)
					lbl.TextStrokeTransparency = 0.4
					lbl.Font = Enum.Font.GothamBold
					lbl.Text = npc.Name
					lbl.Parent = tag
					
					tag.Parent = root
					activeTags[npc] = tag
				end
				
				-- Scale text smaller the further away the NPC is
				local lbl = tag:FindFirstChild("Label")
				if lbl then
					local calculatedSize = math.clamp(16 - (dist / 15), 8, 14)
					lbl.TextSize = calculatedSize
				end
			end
		end
	else
		for npc, tag in pairs(activeTags) do
			if tag then tag:Destroy() end
		end
		activeTags = {}
	end
end)

-- World Click-to-Select Raycast Support
UserInputService.InputBegan:Connect(function(input, gameProcessed)
	if gameProcessed then return end
	if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
		local mousePos = UserInputService:GetMouseLocation()
		local ray = Camera:ViewportPointToRay(mousePos.X, mousePos.Y)
		local params = RaycastParams.new()
		params.FilterType = RaycastFilterType.Exclude
		params.FilterDescendantsInstances = {LocalPlayer.Character}
		
		local result = Workspace:Raycast(ray.Origin, ray.Direction * 200, params)
		if result and result.Instance then
			local model = result.Instance:FindFirstAncestorOfClass("Model")
			if model and isNPC(model) then
				local idx = table.find(selectedNPCs, model)
				if idx then
					table.remove(selectedNPCs, idx)
				else
					table.insert(selectedNPCs, model)
				end
			end
		end
	end
end)

