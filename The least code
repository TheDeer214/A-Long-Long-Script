local function refreshNPCList()
	for _, child in ipairs(scrollingEntities:GetChildren()) do
		if child:IsA("TextButton") then child:Destroy() end
	end
	
	local npcs = getNPCs()
	for _, npc in ipairs(npcs) do
		local rowBtn = Instance.new("TextButton")
		rowBtn.Size = UDim2.new(1, 0, 0, 28)
		local isSel = table.find(selectedNPCs, npc) ~= nil
		rowBtn.BackgroundColor3 = isSel and Color3.fromRGB(40, 100, 40) or Color3.fromRGB(35, 35, 35)
		rowBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
		rowBtn.Text = npc.Name .. (isSel and " [Selected]" or "")
		rowBtn.Font = Enum.Font.Gotham
		rowBtn.TextSize = 11
		rowBtn.Parent = scrollingEntities
		Instance.new("UICorner", rowBtn).CornerRadius = UDim.new(0, 4)
		
		local targetNpc = npc
		rowBtn.MouseButton1Click:Connect(function()
			local idx = table.find(selectedNPCs, targetNpc)
			if idx then
				table.remove(selectedNPCs, idx)
			else
				table.insert(selectedNPCs, targetNpc)
			end
			refreshNPCList()
		end)
	end
	scrollingEntities.CanvasSize = UDim2.new(0, 0, 0, #npcs * 32)
end

selectAllBtn.MouseButton1Click:Connect(function()
	selectedNPCs = getNPCs()
	refreshNPCList()
end)

deselectAllBtn.MouseButton1Click:Connect(function()
	selectedNPCs = {}
	refreshNPCList()
end)

-- Background loop for Highlighting & Distance-Scaling Name ESP
RunService.RenderStepped:Connect(function()
	local allNpcs = getNPCs()
	local char = LocalPlayer.Character
	local pRoot = char and char:FindFirstChild("HumanoidRootPart")
	
	for _, npc in ipairs(allNpcs) do
		local isSel = table.find(selectedNPCs, npc) ~= nil
		local root = npc:FindFirstChild("HumanoidRootPart")
		
		-- Handle Highlight
		local hl = npc:FindFirstChild("EntityHighlight")
		if highlightActive and isSel then
			if not hl then
				hl = Instance.new("Highlight")
				hl.Name = "EntityHighlight"
				hl.FillColor = Color3.fromRGB(255, 50, 50)
				hl.OutlineColor = Color3.fromRGB(255, 255, 255)
				hl.Parent = npc
			end
		else
			if hl then hl:Destroy() end
		end
		
		-- Handle Name ESP with distance-based font size
		local bg = root and root:FindFirstChild("EntityNameESP")
		if nameEspActive and root then
			local dist = pRoot and (pRoot.Position - root.Position).Magnitude or 50
			if not bg then
				bg = Instance.new("BillboardGui")
				bg.Name = "EntityNameESP"
				bg.Size = UDim2.new(0, 100, 0, 40)
				bg.StudsOffset = Vector3.new(0, 2.5, 0)
				bg.AlwaysOnTop = true
				bg.Parent = root
				
				local lbl = Instance.new("TextLabel")
				lbl.Name = "Label"
				lbl.Size = UDim2.new(1, 0, 1, 0)
				lbl.BackgroundTransparency = 1
				lbl.TextColor3 = Color3.fromRGB(255, 255, 255)
				lbl.TextStrokeTransparency = 0.5
				lbl.Font = Enum.Font.GothamBold
				lbl.Parent = bg
			end
			local lbl = bg:FindFirstChild("Label")
			if lbl then
				lbl.Text = npc.Name
				-- Scales smaller the further away the NPC is
				lbl.TextSize = math.clamp(math.floor(220 / math.max(dist, 5)), 8, 14)
			end
		else
			if bg then bg:Destroy() end
		end
	end
end)

task.spawn(function()
