-- Background Update Loop (Highlights: Selected=Red, Unselected=White + Distance-Scaled Name ESP)
task.spawn(function()
	while true do
		refreshNPCList()
		
		for _, npc in ipairs(getNPCs()) do
			local isSel = table.find(selectedNPCs, npc) ~= nil
			
			local hl = npc:FindFirstChild("EntityHighlight")
			if highlightEnabled then
				if not hl then
					hl = Instance.new("Highlight")
					hl.Name = "EntityHighlight"
					hl.Parent = npc
				end
				hl.FillColor = isSel and Color3.fromRGB(255, 50, 50) or Color3.fromRGB(240, 240, 240)
				hl.OutlineColor = Color3.fromRGB(255, 255, 255)
				hl.FillTransparency = isSel and 0.3 or 0.6
			else
				if hl then hl:Destroy() end
			end
			
			local head = npc:FindFirstChild("Head") or npc:FindFirstChild("HumanoidRootPart")
			local bb = npc:FindFirstChild("EntityNameESP")
			if nameEspEnabled and isSel and head then
				if not bb then
					bb = Instance.new("BillboardGui")
					bb.Name = "EntityNameESP"
					bb.Size = UDim2.new(0, 100, 0, 30)
					bb.StudsOffset = Vector3.new(0, 2.5, 0)
					bb.AlwaysOnTop = true
					bb.Parent = npc
					
					local lbl = Instance.new("TextLabel")
					lbl.Name = "Label"
					lbl.Size = UDim2.new(1, 0, 1, 0)
					lbl.BackgroundTransparency = 1
					lbl.TextColor3 = Color3.fromRGB(255, 255, 255)
					lbl.TextStrokeTransparency = 0.5
					lbl.Font = Enum.Font.GothamBold
					lbl.Parent = bb
				end
				local lbl = bb:FindFirstChild("Label")
				if lbl and LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
					local dist = (LocalPlayer.Character.HumanoidRootPart.Position - head.Position).Magnitude
					lbl.TextSize = math.clamp(math.floor(22 - (dist / 8)), 9, 16)
					lbl.Text = npc.Name .. " [" .. math.floor(dist) .. "m]"
				end
			else
				if bb then bb:Destroy() end
			end
		end
		
		task.wait(0.8)
	end
end)

