local function stopControl()
	local character = originalCharacter
	local cameraSubject = originalCameraSubject
	controlEnabled = false

	if character and character.Parent then
		LocalPlayer.Character = character
		if camera then
			if cameraSubject and cameraSubject.Parent then
				camera.CameraSubject = cameraSubject
			else
				local humanoid = character:FindFirstChildOfClass("Humanoid")
				if humanoid then camera.CameraSubject = humanoid end
			end
			if originalCameraType then camera.CameraType = originalCameraType end
			if originalMouseBehavior then UserInputService.MouseBehavior = originalMouseBehavior end
		end
	end

	originalCharacter = nil
	originalCameraSubject = nil
	originalCameraType = nil
	originalMouseBehavior = nil

	controlToggle.Text = "Control Selected NPC: OFF"
	controlToggle.BackgroundColor3 = Color3.fromRGB(60, 60, 60)
end

controlToggle.MouseButton1Click:Connect(function()
	if controlEnabled then
		stopControl()
		return
	end

	if not selectedNPC or not selectedNPC.Parent then
		controlToggle.Text = "Select an NPC First!"
		task.delay(2, function()
			if not controlEnabled then controlToggle.Text = "Control Selected NPC: OFF" end
		end)
		return
	end

	local humanoid = selectedNPC:FindFirstChildOfClass("Humanoid")
	local rootPart = selectedNPC:FindFirstChild("HumanoidRootPart")
	if not humanoid or humanoid.Health <= 0 or not rootPart then return end

	pcall(function()
		for _, part in ipairs(selectedNPC:GetDescendants()) do
	pcall(function()
			if part:IsA("BasePart") then
				part:SetNetworkOwner(LocalPlayer)
			end
		end
	end)

	originalCharacter = LocalPlayer.Character
	if camera then
		originalCameraSubject = camera.CameraSubject
		originalCameraType = camera.CameraType
		originalMouseBehavior = UserInputService.MouseBehavior
		camera.CameraType = Enum.CameraType.Custom
		camera.CameraSubject = humanoid
	end

	controlEnabled = true
	controlToggle.Text = "Control Selected NPC: ON"
	controlToggle.BackgroundColor3 = Color3.fromRGB(150, 50, 50)

	LocalPlayer.Character = selectedNPC
	
	local animScript = selectedNPC:FindFirstChild("Animate")
	if animScript then
		animScript.Disabled = true
		task.wait(0.05)
		animScript.Disabled = false
	end
end)
