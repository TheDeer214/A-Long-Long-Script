local function refreshNPCList()
	for _, child in ipairs(scrollingFrame:GetChildren()) do
		if child:IsA("TextButton") then child:Destroy() end
	end
	
	local npcs = getNPCs()
	for _, npc in ipairs(npcs) do
		local rowBtn = Instance.new("TextButton")
		rowBtn.Size = UDim2.new(1, 0, 0, 25)
		local isSel = table.find(selectedNPCs, npc) ~= nil
		rowBtn.BackgroundColor3 = isSel and Color3.fromRGB(0, 120, 0) or Color3.fromRGB(70, 70, 70)
		rowBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
		rowBtn.Text = npc.Name
		rowBtn.Font = Enum.Font.Gotham
		rowBtn.TextSize = 11
		rowBtn.Parent = scrollingFrame
		
		local targetNpc = npc
		rowBtn.MouseButton1Click:Connect(function()
			local idx = table.find(selectedNPCs, targetNpc)
			if idx then
				table.remove(selectedNPCs, idx)
				if selectedNPC == targetNpc then selectedNPC = selectedNPCs[1] end
			else
				table.insert(selectedNPCs, targetNpc)
				selectedNPC = targetNpc
			end
			refreshNPCList()
			updateHighlights()
		end)
	end
	scrollingFrame.CanvasSize = UDim2.new(0, 0, 0, #npcs * 29)
end

task.spawn(function()
